<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">
    <ProgressBar
        android:id="@+id/pageProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/navy"
        android:gravity="center"
        android:orientation="horizontal">
        <Button android:id="@+id/backButton" style="@style/WebNavButton" android:text="‹" android:contentDescription="Back" />
        <Button android:id="@+id/forwardButton" style="@style/WebNavButton" android:text="›" android:contentDescription="Forward" />
        <Button android:id="@+id/refreshButton" style="@style/WebNavButton" android:text="⟳" android:contentDescription="Refresh" />
        <Button android:id="@+id/homeButton" style="@style/WebNavButton" android:text="⌂" android:contentDescription="Home" />
    </LinearLayout>
</LinearLayout>
